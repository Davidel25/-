# --- Broker ---
BROKER=mock               # mock | ib   (start with mock, then ib+paper, live last)
TRADING_MODE=paper        # paper | live
TWS_USERID=
TWS_PASSWORD=
VNC_SERVER_PASSWORD=
IB_PORT=4004              # docker: 4004 paper / 4003 live.  bare-metal Gateway: 4002 paper / 4001 live
IB_CLIENT_ID=1
IB_MARKET_DATA_TYPE=3     # 1 live, 3 delayed

# --- Scanner ---
WATCHLIST=SPY,QQQ,IWM
SCAN_INTERVAL_SEC=300
ACCOUNT_EQUITY=50000      # fallback when the broker cannot report NetLiquidation

# --- Alerts (optional) ---
TELEGRAM_TOKEN=
TELEGRAM_CHAT_ID=
ALERT_WEBHOOK_URL=
