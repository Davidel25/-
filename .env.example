# --- Broker ---
BROKER=mock               # mock | ib   (start with mock, then ib+paper, live last)
TRADING_MODE=paper        # paper | live
TWS_USERID=
TWS_PASSWORD=
VNC_SERVER_PASSWORD=
IB_PORT=4004              # docker: 4004 paper / 4003 live.  bare-metal Gateway: 4002 paper / 4001 live
IB_CLIENT_ID=1
IB_MARKET_DATA_TYPE=3     # 1 live, 3 delayed

# --- Scanner ---
WATCHLIST=SPY,QQQ,IWM
SCAN_INTERVAL_SEC=300
ACCOUNT_EQUITY=50000      # fallback when the broker cannot report NetLiquidation

# --- Alerts (optional) ---
TELEGRAM_TOKEN=
TELEGRAM_CHAT_ID=
ALERT_WEBHOOK_URL=

# --- Guards / hardening (from_env defaults shown) ---
ENFORCE_MARKET_HOURS=true     # skip scans outside the regular US session (default false when BROKER=mock)
ENFORCE_QUOTE_FRESHNESS=true  # reject chains with stale / untimed quotes
MAX_QUOTE_AGE_SEC=0           # 0 = auto: 120s live (type 1), 1200s delayed (type 3), 60s frozen
REQUIRE_EARNINGS_CLEAR=true   # block signals whose earnings date is unknown or before expiry
EARNINGS_FILE=                # JSON calendar, see src/risk/earnings.py (stocks are flagged without it)
ENTRY_DELTAS_FILE=            # optional manual entry-delta overrides {position key: delta}
DISCIPLINED_SCANNER=true      # credit floor, tight spreads, IV/HV, trend, term structure, skew, 35-45 DTE preference
ALLOWED_WEEKDAYS=             # e.g. 1,2,3 = Tue-Thu entries only (off: validate with /api/breakdown?by=weekday first)
SCALE_OUT_PROFIT_PCT=0        # 0 = off; 0.30 / 0.40 recommends closing half of >= 2 contract positions
TRADE_DB_PATH=data/trades.db  # SQLite trade log (signals, positions, entry deltas, estimated net P&L)
COMMISSION_PER_CONTRACT=0.65  # used for the net-P&L estimate
