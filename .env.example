# --- Broker ---
BROKER=mock               # mock | ib   (start with mock, then ib+paper, live last)
TRADING_MODE=paper        # paper | live
TWS_USERID=
TWS_PASSWORD=
VNC_SERVER_PASSWORD=
IB_PORT=4004              # docker: 4004 paper / 4003 live.  bare-metal Gateway: 4002 paper / 4001 live
IB_CLIENT_ID=1
IB_MARKET_DATA_TYPE=3     # 1 live, 3 delayed

# --- Scanner ---
WATCHLIST=SPY,QQQ           # core universe: liquid index ETFs only (single stocks excluded: friction + gap risk)
UNIVERSE_ALLOWLIST=SPY,QQQ    # symbols that may be scanned for NEW signals; anything else on the watchlist is skipped and reported
PROFIT_TARGET_PCT=0.65        # take profit at this share of the credit (library default is 0.50; 0.60-0.65 tested better)
MAX_RISK_PER_TRADE_PCT=0.10   # max loss of one new trade / equity (hard ceiling 0.10). A 5-wide spread at 0.12-0.15 delta risks ~$440
                              # (2.2% of $20k); the old 2% cap ($400) rejected every signal, 0.025 is the tightest value that admits them.
                              # Other limits still bind: scanner max risk per spread $1,000, total open risk 20% of equity.
SCAN_INTERVAL_SEC=300
ACCOUNT_EQUITY=50000      # fallback when the broker cannot report NetLiquidation

# --- Alerts (optional) ---
TELEGRAM_TOKEN=
TELEGRAM_CHAT_ID=
ALERT_WEBHOOK_URL=

# --- Guards / hardening (from_env defaults shown) ---
ENFORCE_MARKET_HOURS=true     # skip scans outside the regular US session (default false when BROKER=mock)
ENFORCE_QUOTE_FRESHNESS=true  # reject chains with stale / untimed quotes
MAX_QUOTE_AGE_SEC=0           # 0 = auto: 120s live (type 1), 1200s delayed (type 3), 60s frozen
REQUIRE_EARNINGS_CLEAR=true   # block signals whose earnings date is unknown or before expiry
EARNINGS_FILE=                # JSON calendar, see src/risk/earnings.py (stocks are flagged without it)
ENTRY_DELTAS_FILE=            # optional manual entry-delta overrides {position key: delta}
DISCIPLINED_SCANNER=true      # credit floor, tight spreads, IV/HV, trend, term structure, skew, 35-45 DTE preference
ALLOWED_WEEKDAYS=             # e.g. 1,2,3 = Tue-Thu entries only (off: validate with /api/breakdown?by=weekday first)
SCALE_OUT_PROFIT_PCT=0        # 0 = off; 0.30 / 0.40 recommends closing half of >= 2 contract positions
TRADE_DB_PATH=data/trades.db  # SQLite trade log (signals, positions, entry deltas, estimated net P&L)
COMMISSION_PER_CONTRACT=0.65  # used for the net-P&L estimate
BETAS=                        # beta to SPY by symbol, e.g. QQQ=1.15,IWM=1.2,AAPL=1.25 (defaults: SPY 1.0, QQQ 1.15, IWM 1.2, DIA 0.95; unknown = 1.0, flagged)
MAX_NET_BETA_DELTA_PCT=1.0    # cap on |net beta-weighted delta| as a fraction of equity (1.0 = 100%); blocks signals that add exposure past it

# --- Automated earnings feed (optional; the manual EARNINGS_FILE always wins and is the only way to mark CONFIRMED) ---
EARNINGS_PROVIDER=file        # file = manual calendar only | finnhub = automated feed layered underneath it
EARNINGS_API_KEY=             # secret: keep it in .env / a secrets manager, never in git (excluded from logs and repr)
EARNINGS_AUTH=header          # header | query - switch if the vendor rejects the key (the adapter is NOT verified live)
EARNINGS_CACHE_FILE=data/earnings_cache.json
EARNINGS_TTL_HOURS=12         # re-fetch a symbol when its cached date is older than this
EARNINGS_MAX_STALE_HOURS=72   # older cached dates are treated as UNKNOWN (signals blocked)
